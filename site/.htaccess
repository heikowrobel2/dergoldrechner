# Apache (ChemiCloud / LiteSpeed)
Options -Indexes
RewriteEngine On

# Drop www
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://dergoldrechner.de%{REQUEST_URI} [L,R=301]
# Force https (X-Forwarded-Proto check avoids loops behind a proxy/CDN)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://dergoldrechner.de%{REQUEST_URI} [L,R=301]

# Internal files
<FilesMatch "^(config\.php|config\.sample\.php|price-state\.json|price\.lock)$">
  Require all denied
</FilesMatch>

# Pages with personal data (Impressum, Datenschutz): keep out of search engines, also via HTTP header
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(impressum|datenschutz)(/|$)#">
    Header set X-Robots-Tag "noindex, noarchive, follow"
  </If>
</IfModule>

ErrorDocument 404 /404.html

AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .xml .html .css .js .json
AddType video/mp4 .mp4
AddType video/webm .webm
AddType image/webp .webp
AddType font/woff2 .woff2

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000"
  # Asset URLs carry ?v=<build> so long caching is safe
  <FilesMatch "\.(css|js|svg|woff2|webp|jpg|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
